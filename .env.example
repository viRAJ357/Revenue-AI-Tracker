# =============================================================================
# RecoverAI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Security — MUST be changed before production deployment
# ---------------------------------------------------------------------------
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_DO_NOT_USE_THIS

# Token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (local dev — no extra setup required)
DATABASE_URL=sqlite:///./recoverai_audit.db

# PostgreSQL (Docker / production — uncomment and configure)
# DATABASE_URL=postgresql://admin:password@db:5432/recoverai

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
# Local dev (Redis running on localhost)
REDIS_URL=redis://localhost:6379/0

# Docker Compose (uncomment for docker-compose usage)
# REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# Leave blank to default to localhost origins (dev mode)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com
